#include <windows.h>
#include <windowsx.h>
#include <math.h>

LRESULT CALLBACK WindowProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam);

void DrawBezier(HDC hdc,
    double x1, double y1,
    double x2, double y2,
    double x3, double y3,
    double x4, double y4)
{
    double prevX = x1;
    double prevY = y1;

    for (double t = 0; t <= 1; t += 0.001)
    {
        double xt =
            pow(1 - t, 3) * x1 +
            3 * t * pow(1 - t, 2) * x2 +
            3 * pow(t, 2) * (1 - t) * x3 +
            pow(t, 3) * x4;

        double yt =
            pow(1 - t, 3) * y1 +
            3 * t * pow(1 - t, 2) * y2 +
            3 * pow(t, 2) * (1 - t) * y3 +
            pow(t, 3) * y4;

        MoveToEx(hdc, (int)prevX, (int)prevY, NULL);
        LineTo(hdc, (int)xt, (int)yt);

        prevX = xt;
        prevY = yt;
    }
}

// تخزين النقط
int x[4], y[4];
int clickCount = 0;

LRESULT CALLBACK WindowProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
{
    HDC hdc;

    switch (uMsg)
    {
    case WM_LBUTTONDOWN:
    {
        if (clickCount < 4)
        {
            x[clickCount] = GET_X_LPARAM(lParam);
            y[clickCount] = GET_Y_LPARAM(lParam);

            hdc = GetDC(hwnd);

            SetPixel(hdc, x[clickCount], y[clickCount], RGB(255, 0, 0));

            clickCount++;

            if (clickCount == 4)
            {
                DrawBezier(hdc,
                    x[0], y[0],
                    x[1], y[1],
                    x[2], y[2],
                    x[3], y[3]);

                clickCount = 0;
            }

            ReleaseDC(hwnd, hdc);
        }
        return 0;
    }

    case WM_DESTROY:
        PostQuitMessage(0);
        return 0;
    }

    return DefWindowProc(hwnd, uMsg, wParam, lParam);
}

int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE, LPSTR, int nCmdShow)
{
    const char CLASS_NAME[] = "MyWindowClass";

    WNDCLASS wc = {};
    wc.lpfnWndProc = WindowProc;
    wc.hInstance = hInstance;
    wc.lpszClassName = CLASS_NAME;
    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);

    RegisterClass(&wc);

    HWND hwnd = CreateWindowEx(
        0,
        CLASS_NAME,
        "Bezier Curve App",
        WS_OVERLAPPEDWINDOW,
        CW_USEDEFAULT, CW_USEDEFAULT, 800, 600,
        NULL, NULL, hInstance, NULL
    );

    ShowWindow(hwnd, nCmdShow);
    UpdateWindow(hwnd);

    MSG msg = {};

    while (GetMessage(&msg, NULL, 0, 0))
    {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }

    return 0;
}
