#include <windows.h>
#include <windowsx.h>
#include <math.h>
#include <stdio.h>

LRESULT CALLBACK WindowProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam);

void DrawCurve(HDC hdc, double x1, double y1, double x2, double y2, double x3, double y3, double x4, double y4, COLORREF color)
{
    double H[4][4] = {
    {1, 0, 0, 0},
    {0, 1, 0, 0},
    {-3, -2, 3, -1},
    {2, 1, -2, 0}
    };
    
    double u1= x2 - x1;
    double v1= y2 - y1;
    double u2= (x3 - x1)/2;
    double v2= (y3 - y1)/2;
    double u3= (x4 - x2)/2;
    double v3= (y4 - y2)/2;
    double u4= x4 - x3;
    double v4= y4 - y3;

    
    double G[8][2]={
        {x1, y1},
        {u1, v1},
        {x2, y2},
        {u2, v2},
        {x3, y3},
        {u3, v3},
        {x4, y4},
        {u4, v4},
    };
    
    double R[8][2] = {0};

    for (int s = 0; s < 2; s++) {
        for (int i = 0; i < 4; i++) {      
            for (int j = 0; j < 2; j++) {
                R[s*4 + i][j] = 0;
                for (int k = 0; k < 4; k++) {
                    R[s*4 + i][j] += H[i][k] * G[s*4 + k][j];
                }
            }
        }
    }
    
    
    for(int t = 0; t <= 1 ; t=t+0.1){
        double V[4] = {1, t, t*t, t*t*t};
        double X[2] = {0, 0};
        
        for (int j = 0; j < 2; j++) {
           X[j] = 0;
           for (int i = 0; i < 4; i++) {
               X[j] += V[i] * R[i][j];
            }
        }
        
        SetPixel(hdc,round(X[0]), round(X[1]), color);
    }
    
}

int x[4], y[4];
int clickCount = 0;

LRESULT CALLBACK WindowProc(HWND hwnd, UINT uMsg, WPARAM wParam, LPARAM lParam)
{
    HDC hdc;

    switch (uMsg)
    {
        case WM_LBUTTONDOWN:
        {
    if (clickCount < 4)
    {
        x[clickCount] = GET_X_LPARAM(lParam);
        y[clickCount] = GET_Y_LPARAM(lParam);

        hdc = GetDC(hwnd);
        SetPixel(hdc, x[clickCount], y[clickCount], RGB(255, 0, 0));
        ReleaseDC(hwnd, hdc);

        clickCount++;

        if (clickCount == 4)
        {
            hdc = GetDC(hwnd);
            DrawCurve(hdc, x[0], y[0], x[1], y[1], x[2], y[2], x[3], y[3], RGB(255, 0, 0));
            ReleaseDC(hwnd, hdc);

            clickCount = 0;
        }
    }
    return 0;
}

        case WM_DESTROY:
            PostQuitMessage(0);
            return 0;
    }

    return DefWindowProc(hwnd, uMsg, wParam, lParam);
}

int WINAPI WinMain(HINSTANCE hInstance, HINSTANCE hPrevInstance,
                   LPSTR lpCmdLine, int nCmdShow)
{
    const char CLASS_NAME[] = "MyWindowClass";

    WNDCLASS wc = {};
    wc.lpfnWndProc = WindowProc;
    wc.hInstance = hInstance;
    wc.lpszClassName = CLASS_NAME;
    wc.hCursor = LoadCursor(NULL, IDC_ARROW);
    wc.hbrBackground = (HBRUSH)(COLOR_WINDOW + 1);

    RegisterClass(&wc);

    HWND hwnd = CreateWindowEx(
        0,
        CLASS_NAME,
        "Circle Graphics App",
        WS_OVERLAPPEDWINDOW,
        CW_USEDEFAULT, CW_USEDEFAULT, 800, 600,
        NULL, NULL, hInstance, NULL
    );

    ShowWindow(hwnd, nCmdShow);
    UpdateWindow(hwnd);

    MSG msg = {};

    while (GetMessage(&msg, NULL, 0, 0))
    {
        TranslateMessage(&msg);
        DispatchMessage(&msg);
    }

    return 0;
}
